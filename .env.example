# Database (PostgreSQL container running on port 5433)
DATABASE_URL="postgresql://huflit_user:huflit_password@localhost:5433/huflit_translation_db?schema=public"

# Redis (Container running on port 6380, or local 6379)
REDIS_URL="redis://localhost:6379"

# Auth Secret (minimum 32 characters)
AUTH_SECRET="huflit-ai-assisted-translation-practice-secret-key-super-secure-2026"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider Configuration
# Set AI_PROVIDER to "mock" for local/testing without cost, or "openai", "gemini"
AI_PROVIDER="mock"
AI_MODEL_ID="mock-mqm-evaluator-v1"

# Live AI Credentials (optional when AI_PROVIDER="mock")
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_DAILY_BUDGET_USD="50.0"

# Environment
NODE_ENV="development"
PORT=3000
