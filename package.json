{
  "name": "ai-assisted-translation-practice-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Nền tảng thực hành biên dịch Anh–Việt và Việt–Anh tích hợp AI cho sinh viên HUFLIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && (prisma db push --skip-generate || true) && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/workers/evaluationWorker.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.29.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
